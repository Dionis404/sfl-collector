# PostgreSQL (postgres-main, БД sfl)
DB_HOST=postgres-main
DB_PORT=5432
DB_NAME=sfl
DB_USER=goblin
DB_PASSWORD=

# SFL Community API — ключ из сайдбара https://sunflower-land.com/community-docs
SFL_API_KEY=
SFL_PROXY=

# Лимит API общий на IP (~1 запрос / 5 с) — не уменьшай без причины
API_MIN_INTERVAL_SEC=10

TICKETS_ENABLED=true
TICKETS_INTERVAL_SEC=3600
TICKETS_TRACK_FARMERS=true

TOP_FARMS_ENABLED=true
TOP_FARMS_INTERVAL_SEC=3600
TOP_FARMS_N=100
# Фермы с пещерой — источник торговца, если у топа пещеры нет
MERCHANT_SOURCE_FARM_IDS=62559,1

ITEM_CHECKS_ENABLED=true
ITEM_CHECKS_TOP_N=200
ITEM_CHECKS_AUCTION_DELAYS_H=1,24
ITEM_CHECKS_MANUAL_COOLDOWN_SEC=600

DUMP_ENABLED=true
DUMP_FILE_KIND=active
DUMP_TOP_N=500
DUMP_AUCTION_DAYS=14

LOG_LEVEL=INFO

# API для сайта: секрет для POST /admin/item-checks (заголовок X-Admin-Token).
# Пусто = админские эндпоинты выключены. Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=
